const built=await build({entryPoints:['tests/fixtures/executive-preview.tsx'],bundle:true,write:false,outdir:'/tmp/antuario-executive-preview',platform:'browser',format:'esm',jsx:'automatic',define:{'process.env.NODE_ENV':'"development"'},plugins:[{name:'preview-navigation',setup(b){b.onResolve({filter:/^next\/navigation$/},()=>({path:path.resolve('tests/fixtures/navigation-preview.ts')}));b.onResolve({filter:/^next\/(link|image)$/},args=>({path:args.path,namespace:'preview'}));b.onLoad({filter:/.*/,namespace:'preview'},args=>({contents:args.path==='next/link'?'import React from "react";export default function Link({href,children,...props}){return React.createElement("a",{href,...props},children)}':'import React from "react";export default function Image({priority,fill,...props}){return React.createElement("img",props)}',loader:'js',resolveDir:process.cwd()}))}}]})
