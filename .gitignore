# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# backups & temp files
*.bak
*.~lock.*
*.xlsx
*.png.bak

# supabase temp
supabase/.temp/

# audit & temp docs (generated, not source)
AUDITORIA_*.md
AUDITORIA_*.sql
LIMPIEZA_*.sql
GUIA_*.md

# Private operational material and local evidence are not public source.
/private/
/lib/private/
/output/
/docs/verification/
/docs/staging/
/.claude/

# Historical local regression fixtures include actual account financial records.
/tests/client-accounts-db.test.ts
/tests/client-accounts-api-schema.test.ts
/tests/client-accounts-legacy-finance.test.ts

# Historical private cash seed; never replay as a public schema migration.
/supabase/migrations/20261010172244_provisional_cash_snapshot.sql

# Reproducible PDF viewer assets from the pinned npm dependency.
/public/vendor/pdfjs/
